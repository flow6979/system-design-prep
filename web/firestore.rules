rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read and write only their own progress and notes
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /notes/{slug} {
        allow read, write: if request.auth != null && request.auth.uid == uid
          && (!('text' in request.resource.data) || request.resource.data.text.size() < 200000);
      }
    }
  }
}
